# Optional: copy to .env at the repository root. `pnpm dev` loads it for the API.
# Existing shell variables take precedence. AI API settings belong to each
# campaign: open its settings in the web interface to enter key/model/base URL.

MASTER_AI_LLM=cli
MASTER_AI_LLM_CMD=claude
MASTER_AI_LLM_ARGS=-p
